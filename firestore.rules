rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Données privées : chaque utilisatrice ne lit et n'écrit que son propre espace.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Collections sociales (feed, friends…) : règles à définir avec les règles de gestion.
  }
}
